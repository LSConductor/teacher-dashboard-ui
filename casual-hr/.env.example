APP_NAME="Casual HR"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_AU

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local Postgres stands in for DigitalOcean Managed Postgres (syd1).
# Production uses a managed database in Sydney. Do not commit that host or password.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=casual_hr
DB_USERNAME=casual_hr
DB_PASSWORD=casual_hr
# DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

# DigitalOcean Spaces, region syd1. Phase 1 keeps files on the local disk.
# Fill these only on the Sydney host. Do not commit keys.
# SPACES_KEY=
# SPACES_SECRET=
# SPACES_REGION=syd1
# SPACES_BUCKET=
# SPACES_ENDPOINT=https://syd1.digitaloceanspaces.com

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hr@example.test"
MAIL_FROM_NAME="${APP_NAME}"

# Production login is the Staff Portal Google session.
# This application does not hold school OAuth client secrets.
# HR stores a person's Google subject (the sub claim) after the portal account exists.
# VITE_APP_NAME="${APP_NAME}"
